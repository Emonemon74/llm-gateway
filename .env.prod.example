# Copy to .env.prod on the server and fill in. NEVER commit .env.prod.
# Generate secrets with:  openssl rand -base64 32 | tr -d '=+/' | cut -c1-40
SITE_ADDRESS=your-host.example.com      # or <ip-with-dashes>.nip.io ; HTTPS is automatic
POSTGRES_PASSWORD=change-me
ADMIN_TOKEN=change-me-long-random       # protects /admin (never exposed publicly) and metrics scraping
GRAFANA_ADMIN_PASSWORD=change-me

# Optional real providers (the demo works without them via the built-in mock upstream)
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=

# Demo upstream latency
MOCK_LATENCY_MS=200
